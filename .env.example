# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=3000

# Public address of the site, without a trailing slash. Used in canonical links, sitemap and Open Graph.
SITE_URL=https://www.example.cz

# How many reverse proxies sit in front of the app (Nginx, Cloudflare...). 0 = none.
# Rate limiting reads the client IP from this, so keep it accurate.
TRUST_PROXY=0

# Long random string for signing form tokens. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CSRF_SECRET=

# Where orders, bookings and messages go. Set at least one of the two channels.
# Telegram: create a bot with @BotFather, send it a message, then find chat_id via getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail over SMTP (optional if Telegram is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Cloudflare Turnstile (optional extra spam protection, leave empty to turn off)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# true = shows [doplnit] labels where data is missing. Set false once you have filled in the data,
# or for launch if you prefer to hide those blocks.
SHOW_PLACEHOLDERS=true
