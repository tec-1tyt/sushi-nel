{
  "name": "sushinel-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web sushiNEL, Chomutov. Express server with server-rendered pages and JSON content.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "check:data": "node server/check-data.js",
    "test": "node --test tests/",
    "vendor": "node tools/vendor.mjs",
    "build:static": "node tools/build-static.mjs"
  },
  "dependencies": {
    "compression": "1.8.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "gsap": "3.15.1",
    "leaflet": "1.9.4",
    "lenis": "1.3.27"
  }
}
